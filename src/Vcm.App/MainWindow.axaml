<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Vcm.App"
        xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
        x:Class="Vcm.App.MainWindow"
        x:CompileBindings="True"
        Width="1400" Height="900"
        MinWidth="1040" MinHeight="680"
        Title="Video Collection Manager"
        Background="{StaticResource Deep}"
        FontFamily="Inter, Segoe UI, sans-serif">

  <Grid RowDefinitions="*,Auto" ColumnDefinitions="214,*">

    <!-- SIDEBAR -->
    <Border Grid.Row="0" Grid.Column="0" Name="Sidebar" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">

        <StackPanel Grid.Row="0" Margin="18,20,18,14">
          <TextBlock Text="Video Collection" Foreground="{StaticResource Text}"
                     FontSize="15" FontWeight="SemiBold"/>
          <TextBlock Name="LibrarySummary" Text="no videos yet" Foreground="{StaticResource Faint}"
                     FontSize="11.5" Margin="0,3,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="14,0,14,16" Spacing="7">
          <Button Name="AddPathButton" Classes="primary" Content="+   Add path"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          <Button Name="RescanButton" Classes="tool" Content="Rescan all"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        </StackPanel>

        <ListBox Grid.Row="2" Name="Nav" Classes="nav" SelectedIndex="1">
          <ListBoxItem Content="Now playing"/>
          <ListBoxItem Content="Locations"/>
          <ListBoxItem Content="Tags"/>
          <ListBoxItem Content="Rating"/>
          <ListBoxItem Content="Most viewed"/>
          <ListBoxItem Content="Duplicates"/>
        </ListBox>

        <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                Padding="18,13">
          <StackPanel Spacing="10">
            <Button Name="UpdateButton" Classes="primary" IsVisible="False"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Content="Update available"/>
            <StackPanel>
              <TextBlock Text="STATUS" Classes="colhead"/>
              <TextBlock Name="StatusText" Text="idle" Foreground="{StaticResource Dim}"
                         FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- CONTENT -->
    <Panel Grid.Row="0" Grid.Column="1">

      <!-- NOW PLAYING -->
      <Grid Name="PageNowPlaying" IsVisible="False" RowDefinitions="Auto,*">
        <Border Grid.Row="0" Name="NowHeader" Padding="24,18,24,14">
          <StackPanel>
            <TextBlock Name="NowTitle" Text="Nothing playing" Foreground="{StaticResource Text}"
                       FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Name="NowSubtitle" Text="Pick a video from Locations or Tags"
                       Foreground="{StaticResource Faint}" FontSize="12" Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis"/>

            <!-- The tags on this video, so what is applied is visible rather than only
                 discoverable by typing into the suggestion box. -->
            <ItemsControl Name="NowTags" Margin="0,10,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:TagRow">
                  <!-- Display only, deliberately: a delete control here is too easy to hit by
                       accident while reaching for the video. -->
                  <Border Classes="tagchip">
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}"
                               FontSize="12.5"/>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Every tag already in use, click to apply. Saves typing a tag that exists, and
                 keeps near-duplicates from creeping in. Tags already on this video are left out,
                 since re-applying one would do nothing. -->
            <StackPanel Name="AddTagSection" IsVisible="False" Margin="0,2,0,0">
              <TextBlock Text="CLICK TO ADD" Classes="colhead" Margin="0,0,0,6"/>
              <ItemsControl Name="AvailableTags">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:TagRow">
                    <Button Classes="addchip" Content="{Binding Name}" Click="OnAddTagChipClick"
                            ToolTip.Tip="Add this tag to the playing video"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Name="VideoFrame" Focusable="True" Margin="24,0,24,18" CornerRadius="10" Background="#07080A"
                BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True">
          <Panel>
            <TextBlock Name="VideoPlaceholder" Text="video surface" Foreground="#2A3040"
                       FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <vlc:VideoView Name="Video">
              <!-- A transparent overlay. VideoView only forwards pointer events when it has
                   Content, which it shows in a floating window above the native surface; without
                   this, clicks land on the native window and Avalonia never sees them. -->
              <Border Name="VideoOverlay" Background="Transparent"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </vlc:VideoView>
          </Panel>
        </Border>
      </Grid>

      <!-- LOCATIONS -->
      <Grid Name="PageLocations" Background="{StaticResource Deep}" ColumnDefinitions="312,*">
        <Border Grid.Column="0" Background="#12151B"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="ROOT FOLDERS" Classes="colhead" Margin="20,20,0,10"/>
            <TreeView Grid.Row="1" Name="Tree" Margin="8,0,8,8">
              <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="vm:FolderRow">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
                </Style>
              </TreeView.Styles>
              <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="vm:FolderRow" ItemsSource="{Binding Children}">
                  <Grid ColumnDefinitions="*,Auto" Height="30" ToolTip.Tip="{Binding FullPath}">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                               FontWeight="{Binding IsRoot, Converter={x:Static vm:Conv.BoolToWeight}}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding CountText}" Classes="cell dim"
                               Margin="10,0,6,0"/>
                  </Grid>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,20,24,14">
            <StackPanel Grid.Column="0">
              <TextBlock Name="FolderTitle" Text="Select a folder" Foreground="{StaticResource Text}"
                         FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Name="FolderSubtitle" Text="" Foreground="{StaticResource Faint}"
                         FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
              <Border Background="#13161C" BorderBrush="{StaticResource Line}" BorderThickness="1"
                      CornerRadius="7" Padding="2" Width="220">
                <TextBox Name="SearchBox" Watermark="Search all locations…" BorderThickness="0"
                         Background="Transparent" FontSize="12.5" Padding="8,5"
                         Foreground="{StaticResource Text}"/>
              </Border>
              <CheckBox Name="RecursiveToggle" Content="Include subfolders"
                        Foreground="{StaticResource Dim}" FontSize="12"/>
              <Button Name="RenameButton" Classes="tool" Content="Rename"
                      ToolTip.Tip="Rename the selected file on disk (F2). Ratings and history follow it."/>
              <Button Name="RemoveRootButton" Classes="tool" Content="Remove root"/>
              <Button Name="PlayFolderButton" Classes="primary" Content="▶  Play all"/>
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Margin="24,0,24,0" BorderBrush="{StaticResource Line}"
                  BorderThickness="0,0,0,1" Padding="12,0,12,9">
            <Grid ColumnDefinitions="*,250,86,78">
              <TextBlock Grid.Column="0" Text="NAME" Classes="colhead"/>
              <TextBlock Grid.Column="1" Text="TAGS" Classes="colhead"/>
              <TextBlock Grid.Column="2" Text="LENGTH" Classes="colhead" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="3" Text="VIEWS" Classes="colhead" HorizontalAlignment="Right"/>
            </Grid>
          </Border>

          <ListBox Grid.Row="2" Name="LocList" Classes="rows" Margin="24,0,24,10">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:VideoRow">
                <Border Padding="12,9" Background="Transparent">
                  <Grid ColumnDefinitions="*,250,86,78">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="cell"/>
                    <TextBlock Grid.Column="1" Text="{Binding Tags}" Classes="cell dim"/>
                    <TextBlock Grid.Column="2" Text="{Binding Duration}" Classes="num"/>
                    <TextBlock Grid.Column="3" Text="{Binding Views}" Classes="num"
                               Foreground="{StaticResource Dim}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>

      <!-- TAGS -->
      <Grid Name="PageTags" Background="{StaticResource Deep}" IsVisible="False" RowDefinitions="Auto,Auto,Auto,*">
        <StackPanel Grid.Row="0" Margin="24,20,24,14">
          <TextBlock Text="Tags" Foreground="{StaticResource Text}" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="Pick a tag to see everything carrying it" Foreground="{StaticResource Faint}"
                     FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <ListBox Grid.Row="1" Name="TagChips" Classes="chips" Margin="24,0,24,16"
                 SelectionMode="Single">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:TagRow">
              <TextBlock Text="{Binding Label}"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" Margin="24,0,24,0" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,1" Padding="12,9">
          <Grid ColumnDefinitions="*,250,86,78">
            <TextBlock Grid.Column="0" Name="TagHeader" Text="NAME" Classes="colhead"/>
            <TextBlock Grid.Column="1" Text="FOLDER" Classes="colhead"/>
            <TextBlock Grid.Column="2" Text="LENGTH" Classes="colhead" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="3" Text="VIEWS" Classes="colhead" HorizontalAlignment="Right"/>
          </Grid>
        </Border>

        <ListBox Grid.Row="3" Name="TagList" Classes="rows" Margin="24,0,24,10">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:VideoRow">
              <Border Padding="12,9" Background="Transparent">
                <Grid ColumnDefinitions="*,250,86,78">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="cell"/>
                  <TextBlock Grid.Column="1" Text="{Binding Folder}" Classes="cell dim"/>
                  <TextBlock Grid.Column="2" Text="{Binding Duration}" Classes="num"/>
                  <TextBlock Grid.Column="3" Text="{Binding Views}" Classes="num"
                             Foreground="{StaticResource Dim}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!-- RATING -->
      <Grid Name="PageRating" Background="{StaticResource Deep}" IsVisible="False" RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,20,24,14">
          <StackPanel Grid.Column="0">
            <TextBlock Text="Rating" Foreground="{StaticResource Text}" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="Likes and dislikes accumulate — one vote per viewing session"
                       Foreground="{StaticResource Faint}" FontSize="12" Margin="0,4,0,0"/>
          </StackPanel>
          <Border Grid.Column="1" Background="#13161C" CornerRadius="8" Padding="3"
                  BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <RadioButton Classes="seg" Name="SortNet" Content="Net score" GroupName="rate" IsChecked="True"/>
              <RadioButton Classes="seg" Name="SortRatio" Content="Ratio" GroupName="rate"/>
              <RadioButton Classes="seg" Name="SortLiked" Content="Most liked" GroupName="rate"/>
              <RadioButton Classes="seg" Name="SortHated" Content="Most disliked" GroupName="rate"/>
            </StackPanel>
          </Border>
        </Grid>

        <Border Grid.Row="1" Margin="24,0,24,0" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,1" Padding="12,9">
          <Grid ColumnDefinitions="*,230,72,78,66,66">
            <TextBlock Grid.Column="0" Text="NAME" Classes="colhead"/>
            <TextBlock Grid.Column="1" Text="FOLDER" Classes="colhead"/>
            <TextBlock Grid.Column="2" Text="LIKES" Classes="colhead" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="3" Text="DISLIKES" Classes="colhead" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="4" Text="RATIO" Classes="colhead" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="5" Text="SCORE" Classes="colhead" HorizontalAlignment="Right"/>
          </Grid>
        </Border>

        <ListBox Grid.Row="2" Name="RateList" Classes="rows" Margin="24,0,24,10">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:VideoRow">
              <Border Padding="12,9" Background="Transparent">
                <Grid ColumnDefinitions="*,230,72,78,66,66">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="cell"/>
                  <TextBlock Grid.Column="1" Text="{Binding Folder}" Classes="cell dim"/>
                  <TextBlock Grid.Column="2" Text="{Binding Likes}" Classes="num"
                             Foreground="{StaticResource Good}"/>
                  <TextBlock Grid.Column="3" Text="{Binding Dislikes}" Classes="num"
                             Foreground="{StaticResource Bad}"/>
                  <TextBlock Grid.Column="4" Text="{Binding RatioText}" Classes="num"
                             Foreground="{StaticResource Dim}"/>
                  <TextBlock Grid.Column="5" Text="{Binding ScoreText}" Classes="num"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!-- MOST VIEWED -->
      <Grid Name="PageViewed" Background="{StaticResource Deep}" IsVisible="False" RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,20,24,14">
          <StackPanel Grid.Column="0">
            <TextBlock Text="Most viewed" Foreground="{StaticResource Text}" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="Hover a row for the per-view breakdown. Sessions under 10 s are not counted."
                       Foreground="{StaticResource Faint}" FontSize="12" Margin="0,4,0,0"/>
          </StackPanel>
          <Border Grid.Column="1" Background="#13161C" CornerRadius="8" Padding="3"
                  BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <RadioButton Classes="seg" Name="SortTime" Content="Total time" GroupName="view" IsChecked="True"/>
              <RadioButton Classes="seg" Name="SortViews" Content="View count" GroupName="view"/>
            </StackPanel>
          </Border>
        </Grid>

        <Border Grid.Row="1" Margin="24,0,24,0" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,1" Padding="12,9">
          <Grid ColumnDefinitions="*,230,100,96,86">
            <TextBlock Grid.Column="0" Text="NAME" Classes="colhead"/>
            <TextBlock Grid.Column="1" Text="FOLDER" Classes="colhead"/>
            <TextBlock Grid.Column="2" Text="TOTAL TIME" Classes="colhead" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="3" Text="VIEWS" Classes="colhead" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="4" Text="LENGTH" Classes="colhead" HorizontalAlignment="Right"/>
          </Grid>
        </Border>

        <ListBox Grid.Row="2" Name="ViewList" Classes="rows" Margin="24,0,24,10">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:VideoRow">
              <Border Padding="12,9" Background="Transparent" ToolTip.Tip="{Binding WatchTooltip}">
                <Grid ColumnDefinitions="*,230,100,96,86">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="cell"/>
                  <TextBlock Grid.Column="1" Text="{Binding Folder}" Classes="cell dim"/>
                  <TextBlock Grid.Column="2" Text="{Binding Watched}" Classes="num"
                             Foreground="{StaticResource Hot}"/>
                  <TextBlock Grid.Column="3" Text="{Binding Views}" Classes="num"/>
                  <TextBlock Grid.Column="4" Text="{Binding Duration}" Classes="num"
                             Foreground="{StaticResource Dim}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!-- DUPLICATES -->
      <Grid Name="PageDupes" Background="{StaticResource Deep}" IsVisible="False" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Margin="24,20,24,14">
          <TextBlock Text="Duplicates" Foreground="{StaticResource Text}" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="Same content hash, different paths. Review and delete manually."
                     Foreground="{StaticResource Faint}" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="24,0,24,10">
          <ItemsControl Name="DupeList">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:DuplicateRow">
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="9" Padding="16,13" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Text="{Binding Header}" Foreground="{StaticResource Text}"
                               FontSize="13.5" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding Paths}" Margin="0,9,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:PathRow">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                            <TextBlock Grid.Column="0" Text="{Binding Path}" Classes="cell dim"
                                       FontFamily="Consolas,Menlo,monospace"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="tool" Content="Show in folder"
                                    Padding="9,3" FontSize="11.5" Margin="10,0,0,0"
                                    Click="OnRevealClick"
                                    ToolTip.Tip="Open the containing folder with this file selected"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Panel>

    <!-- PLAYER BAR -->
    <Border Grid.Row="1" Grid.ColumnSpan="2" Name="PlayerBar" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <Grid RowDefinitions="Auto,Auto" Margin="22,12,22,14">

        <vm:HeatSeekBar Grid.Row="0" Name="Seek" Margin="0,0,0,8"/>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto">

          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <Button Name="PrevButton" Classes="tool" Content="◀◀" Padding="11,6"/>
            <Button Name="PlayButton" Classes="primary" Content="▶" Padding="17,6"/>
            <Button Name="NextButton" Classes="tool" Content="▶▶" Padding="11,6"/>
            <Button Name="FullScreenButton" Classes="tool" Content="⛶" Padding="11,6"
                    ToolTip.Tip="Full screen (tap Ctrl, or double-click the video). Esc exits."/>
          </StackPanel>

          <TextBlock Grid.Column="1" Name="TimeText" Classes="num" Margin="14,0,0,0"
                     Foreground="{StaticResource Dim}" Text="—"/>

          <StackPanel Grid.Column="2" Margin="22,0" VerticalAlignment="Center">
            <TextBlock Name="BarTitle" Text="Nothing playing" Classes="cell" FontWeight="SemiBold"/>
            <TextBlock Name="BarSubtitle" Text="" Foreground="{StaticResource Faint}"
                       FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>

          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <Button Name="LikeButton" Classes="tool" Padding="11,6">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="▲" Foreground="{StaticResource Good}" FontSize="11"/>
                <TextBlock Text="Like" FontSize="12.5"/>
                <TextBlock Name="LikeCount" Text="0" Foreground="{StaticResource Dim}" FontSize="12.5"/>
              </StackPanel>
            </Button>
            <Button Name="DislikeButton" Classes="tool" Padding="11,6">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="▼" Foreground="{StaticResource Bad}" FontSize="11"/>
                <TextBlock Text="Dislike" FontSize="12.5"/>
                <TextBlock Name="DislikeCount" Text="0" Foreground="{StaticResource Dim}" FontSize="12.5"/>
              </StackPanel>
            </Button>
            <Border Background="#13161C" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="7" Padding="2" Width="190">
              <AutoCompleteBox Name="TagInput" Watermark="add or pick a tag…"
                               BorderThickness="0" Background="Transparent" FontSize="12.5"
                               Padding="8,5" Foreground="{StaticResource Text}"
                               FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                               ToolTip.Tip="Type a new tag, or start typing to pick an existing one. Enter applies it."/>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="4" Margin="20,0,0,0" VerticalAlignment="Center" Spacing="4">
            <TextBlock Text="REPLAYS" Classes="colhead" HorizontalAlignment="Center"/>
            <vm:HeatLegend/>
            <Grid ColumnDefinitions="*,*" Width="86">
              <TextBlock Grid.Column="0" Text="once" Foreground="{StaticResource Faint}" FontSize="10"/>
              <TextBlock Grid.Column="1" Text="often" Foreground="{StaticResource Faint}" FontSize="10"
                         HorizontalAlignment="Right"/>
            </Grid>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
