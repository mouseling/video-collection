<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>   <!-- WinExe = no console window on Windows; runs normally on Linux -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>VideoCollectionManager</AssemblyName>
    <RootNamespace>Vcm.App</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      Do NOT publish this as a single file. VideoLAN.LibVLC.Windows contributes libvlc plus ~320
      plugin DLLs as content under libvlc/win-x64/, and that is exactly where libvlc looks for them
      at runtime. PublishSingleFile + IncludeNativeLibrariesForSelfExtract sweeps those DLLs into
      the executable, leaving the directory on disk holding only lua scripts and headers — the app
      then starts but can play nothing. Publish to a folder instead.
    -->
    <PublishSingleFile>false</PublishSingleFile>

  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.18" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.2" />
    <!-- Keep in step with the vpk CLI the release workflow installs. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Vcm.Core/Vcm.Core.csproj" />
    <ProjectReference Include="../Vcm.Media/Vcm.Media.csproj" />
  </ItemGroup>

  <!--
    The package drops a full 96 MB x86 copy of VLC alongside the x64 one. Its own
    VlcWindowsX86Enabled switch does not take effect when cross-publishing, so remove the
    directory outright — a win-x64 build can never load it.
  -->
  <Target Name="RemoveVlcX86" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)libvlc/win-x86" ContinueOnError="true" />
  </Target>

  <!--
    Bakes the updater's read-only PAT into the binary from an UNTRACKED file (updater.token at the
    repository root, gitignored), so the value never lives in committed source. CI injects it via
    the UPDATER_TOKEN environment variable instead, which is why env wins over the file. If neither
    is present the constant compiles to "" and the updater runs token-less — correct for a public
    repo, but this repo is private, so a release built without the token cannot self-update.
  -->
  <Target Name="GenerateUpdaterSecrets" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <UpdaterTokenFile>$(MSBuildProjectDirectory)\..\..\updater.token</UpdaterTokenFile>
      <UpdaterTokenValue Condition="'$(UPDATER_TOKEN)' != ''">$(UPDATER_TOKEN)</UpdaterTokenValue>
      <UpdaterTokenValue Condition="'$(UpdaterTokenValue)' == '' AND Exists('$(UpdaterTokenFile)')">$([System.IO.File]::ReadAllText('$(UpdaterTokenFile)').Trim())</UpdaterTokenValue>
      <UpdaterTokenLiteral Condition="'$(UpdaterTokenValue)' != ''">"$(UpdaterTokenValue)"</UpdaterTokenLiteral>
      <UpdaterTokenLiteral Condition="'$(UpdaterTokenValue)' == ''">""</UpdaterTokenLiteral>
      <UpdaterSecretsFile>$(IntermediateOutputPath)UpdaterSecrets.g.cs</UpdaterSecretsFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(UpdaterSecretsFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="namespace Vcm.App { internal static class UpdaterSecrets { public const string Token = $(UpdaterTokenLiteral)%3B } }" />
    <ItemGroup>
      <Compile Include="$(UpdaterSecretsFile)" />
    </ItemGroup>
  </Target>

</Project>
